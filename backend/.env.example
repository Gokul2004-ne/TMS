# TMS Backend Environment Configuration
# Use SQLite by default for instant zero-dependency local dev/testing
DATABASE_URL=sqlite+aiosqlite:///./tms.db

# To use PostgreSQL in Docker or local instance:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tms_db

# Microservice URL for AI engine
AI_SERVICE_URL=http://localhost:8001

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
